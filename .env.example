# ==============================================================================
# ExceptionOS Environment Variables
# AssemblyAI Voice Agent Hackathon
# ==============================================================================

# Required: AssemblyAI API Key for live Voice Agent streaming (Speech-to-Speech)
# The server uses this key to generate short-lived tokens via https://agents.assemblyai.com/v1/token
# This key is strictly kept server-side and never exposed to the browser.
ASSEMBLYAI_API_KEY=

# Optional: Port configuration (default: 3000)
PORT=3000

# Optional: Node Environment ('development' | 'production')
NODE_ENV=production
